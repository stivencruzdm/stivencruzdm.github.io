const secEls=new Map(); let lastOrder='';
function renderAll(){
  document.documentElement.style.setProperty('--red',S.theme.red);document.documentElement.style.setProperty('--cyan',S.theme.cyan);
  document.documentElement.classList.toggle('noanim',!!S.ui.noAnim);
  $('#bName').textContent=S.brand.name;$('#bSub').textContent=S.brand.sub;
  {const lg=S.brand.logo,li=$('#logoImg');$('#logoSvg').hidden=!!lg;li.hidden=!lg;if(lg&&li.getAttribute('src')!==lg)li.src=lg;$('#bTxt').hidden=!!lg&&S.brand.showName===false}$('#foot').textContent=`© ${new Date().getFullYear()} ${S.brand.name} · ${S.brand.sub}`;
  $('#editBtn').hidden=!AUTHED||(!!S.ui.hideEdit&&$('#dr').hidden);
  const main=$('#main');const order=S.modules.filter(m=>m.on&&MODS[m.id]);const sig=order.map(m=>m.id).join(',');
  const keep=new Set();
  order.forEach(m=>{keep.add(m.id);let el=secEls.get(m.id);if(!el){el=document.createElement('section');el.id=m.id;el.className=m.id==='hero'?'hero':'sec';secEls.set(m.id,el);main.append(el);lastOrder=''}
    const h=MODS[m.id](m);if(el._h!==h){el.innerHTML=h;el._h=h}});
  secEls.forEach((el,id)=>{if(!keep.has(id)){el.remove();secEls.delete(id);lastOrder=''}});
  if(sig!==lastOrder){order.forEach(m=>main.append(secEls.get(m.id)));lastOrder=sig}
  $('#nav').innerHTML=order.filter(m=>m.id!=='hero').map(m=>`<a href="#${m.id}" data-go="${m.id}">${esc(m.label)}</a>`).join('');
  post();
}

/* ---------- animaciones ---------- */
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
let rIO,mIO,cIO,spy;
function post(){
  if(!('IntersectionObserver' in window)){$$('.rv').forEach(e=>e.classList.add('in'));return}
  rIO=rIO||new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rIO.unobserve(e.target)}}),{threshold:.08,rootMargin:'0px 0px -6% 0px'});
  $$('.rv:not(.in)').forEach(e=>rIO.observe(e));
  mIO=mIO||new IntersectionObserver(es=>es.forEach(e=>{const t=e.target;
    if(t.classList.contains('yt')){if(e.isIntersecting&&!t.firstChild)t.innerHTML=`<iframe src="${ytSrc(t.dataset.yt,false,false)}" allow="autoplay; encrypted-media" tabindex="-1" title=""></iframe>`;else if(!e.isIntersecting)t.innerHTML=''}
    else if(t.tagName==='VIDEO'){if(e.isIntersecting)t.play().catch(()=>{});else t.pause()}}),{threshold:.25});
  $$('.yt:not([data-o]),video[data-auto]:not([data-o])').forEach(e=>{e.dataset.o=1;mIO.observe(e)});
  cIO=cIO||new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;cIO.unobserve(e.target);countUp(e.target)}),{threshold:.6});
  $$('[data-count]:not([data-o])').forEach(e=>{e.dataset.o=1;cIO.observe(e)});
  spy=spy||new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){$$('#nav a').forEach(a=>a.classList.toggle('on',a.dataset.go===e.target.id))}}),{rootMargin:'-40% 0px -55% 0px'});
  secEls.forEach(el=>{if(!el._s){el._s=1;spy.observe(el)}});
  startRot();
  $$('.card:not([data-t])').forEach(c=>{c.dataset.t=1;if(reduce)return;
    c.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;const r=c.getBoundingClientRect();c.style.setProperty('--ry',((e.clientX-r.left)/r.width-.5)*7+'deg');c.style.setProperty('--rx',(.5-(e.clientY-r.top)/r.height)*6+'deg')});
    c.addEventListener('pointerleave',()=>{c.style.setProperty('--rx','0deg');c.style.setProperty('--ry','0deg')})});
}
function countUp(el){const n=+el.dataset.count,pre=el.dataset.pre,suf=el.dataset.suf;if(reduce||S.ui.noAnim||n>999)return;const t0=performance.now();
  (function f(t){const p=Math.min(1,(t-t0)/1100),e=1-Math.pow(1-p,3);el.textContent=pre+Math.round(n*e)+suf;if(p<1)requestAnimationFrame(f)})(t0)}
let rotT,rotI=0;
function startRot(){clearInterval(rotT);const el=$('#rot');if(!el||reduce||S.ui.noAnim||S.hero.roles.length<2)return;
  rotT=setInterval(()=>{const e=$('#rot');if(!e){clearInterval(rotT);return}rotI=(rotI+1)%S.hero.roles.length;e.textContent=S.hero.roles[rotI];e.style.animation='none';void e.offsetWidth;e.style.animation=''},2400)}

/* ---------- eventos del sitio ---------- */
function goto(id){const el=document.getElementById(id);if(el)el.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'})}
document.addEventListener('click',e=>{
  const g=e.target.closest('[data-go]');if(g){e.preventDefault();goto(g.dataset.go);return}
  const fc=e.target.closest('#main [data-client],#main [data-kat],#main [data-clear],#main .cell');
  if(fc){const d=fc.dataset,tg=(s,v)=>s.has(v)?s.delete(v):s.add(v);
    if(d.clear==='c')selC.clear();else if(d.clear==='k')selK.clear();else if(d.client!=null)tg(selC,d.client);else if(d.kat!=null)tg(selK,d.kat);
    else{selC.clear();selK.clear();selK.add(d.cat)}
    renderAll();if(fc.classList.contains('cell'))goto('works');return}
  const o=e.target.closest('[data-open]');if(o){openLB(o.dataset.open,0);return}
  const cp=e.target.closest('[data-copy]');if(cp){copy(cp.dataset.copy);return}
});
let qT;$('#q').addEventListener('input',e=>{clearTimeout(qT);qT=setTimeout(()=>{const first=!query&&e.target.value;query=e.target.value;renderAll();if(first||query)goto('works')},220)});

/* ---------- visor ---------- */
let LB={w:null,i:0,snd:false},LBV='h';
function applyView(){const st=$('#lbStage');st.dataset.view=LBV;$$('#lbView button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.view===LBV));st.scrollTop=0;st.scrollLeft=0}
const lb=$('#lb');
function openLB(id,i){const w=S.works.find(x=>x.id===id);if(!w)return;LB={w,i,snd:false};lb.hidden=false;document.body.style.overflow='hidden';drawLB();$('.lb-x',lb).focus()}
function closeLB(){lb.hidden=true;$('#lbStage').innerHTML='';document.body.style.overflow=''}
function drawLB(){const w=LB.w,ms=w.media.map(parseMedia).filter(Boolean),m=ms[LB.i];
  const st=$('#lbStage');st.innerHTML=mediaFull(m,w,LB.snd);st.classList.toggle('scroll',!!m&&(m.k==='img'||m.k==='drive-i'));$('#lbView').hidden=!(m&&(m.k==='img'||m.k==='drive-i'));applyView();
  const snd=$('#lbSnd');snd.hidden=!(m&&(m.k==='yt'||m.k==='file-v'));snd.textContent=LB.snd?'Silenciar':'Activar sonido';
  $$('.lb-nav',lb).forEach(b=>b.hidden=ms.length<2);
  $('#lbT').textContent=w.title;
  $('#lbM').innerHTML=[esc(cname(w.clientId)),`<b>${esc(w.cat)}</b>`,esc(w.year)].filter(x=>x&&x!=='<b></b>').join(' · ');
  $('#lbD').textContent=w.desc||'';
  {const mm=m&&m.m,cp=$('#lbCap');const tg=String(mm?.tags||'').split(',').map(s=>s.trim()).filter(Boolean);cp.hidden=!(mm&&(mm.desc||tg.length));
   cp.innerHTML=mm?`${mm.desc?`<p>${esc(mm.desc)}</p>`:''}${tg.length?`<ul class="chips">${tg.map(t=>`<li>${esc(t)}</li>`).join('')}</ul>`:''}`:''}
  $('#lbTh').hidden=ms.length<2;
  $('#lbTh').innerHTML=ms.map((x,i)=>`<button type="button" class="${i===LB.i?'on':''}" data-th="${i}" aria-label="Medio ${i+1}">${x.k==='file-v'?`<video muted preload="metadata" src="${esc(x.u)}"></video>`:`<img alt="" src="${esc(poster(x))}">`}</button>`).join('');
  LB.n=ms.length}
lb.addEventListener('click',e=>{const vb=e.target.closest('[data-view]');if(vb){LBV=vb.dataset.view;applyView();return}
  const t=e.target.closest('[data-lb],[data-th]');if(!t)return;
  if(t.dataset.th!=null){LB.i=+t.dataset.th;LB.snd=false;drawLB();return}
  const a=t.dataset.lb;
  if(a==='close')closeLB();
  else if(a==='next'){LB.i=(LB.i+1)%LB.n;LB.snd=false;drawLB()}
  else if(a==='prev'){LB.i=(LB.i-1+LB.n)%LB.n;LB.snd=false;drawLB()}
  else if(a==='snd'){LB.snd=!LB.snd;const v=$('#lbStage video');if(v){v.muted=!LB.snd;$('#lbSnd').textContent=LB.snd?'Silenciar':'Activar sonido'}else drawLB()}});
$('#lbStage').addEventListener('wheel',e=>{const st=e.currentTarget;if(LBV==='v'&&st.classList.contains('scroll')&&st.scrollWidth>st.clientWidth&&Math.abs(e.deltaY)>Math.abs(e.deltaX)){e.preventDefault();st.scrollLeft+=e.deltaY}},{passive:false});
document.addEventListener('keydown',e=>{
  if(!lb.hidden){if(e.key==='Escape')closeLB();else if(e.key==='ArrowRight'&&LB.n>1)lb.querySelector('[data-lb=next]').click();else if(e.key==='ArrowLeft'&&LB.n>1)lb.querySelector('[data-lb=prev]').click();return}
  if((e.ctrlKey||e.metaKey)&&!dr.hidden&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){const k=e.key.toLowerCase();if(k==='z'&&!e.shiftKey){e.preventDefault();applyHist(-1)}else if(k==='y'||(k==='z'&&e.shiftKey)){e.preventDefault();applyHist(1)}}
  if(e.key==='E'&&e.shiftKey&&(e.ctrlKey||e.metaKey)){e.preventDefault();toggleDr()}
  if(e.key==='Escape'&&!$('#dr').hidden)toggleDr(false)});

/* ---------- panel de edición ---------- */
const dr=$('#dr');let tab='general',editW=null;
const TABS=[['general','General'],['modulos','Módulos'],['clientes','Grupos'],['trabajos','Trabajos'],['exp','Experiencia'],['skills','Competencias'],['estilo','Estilo'],['datos','Copias']];
function toggleDr(v){const open=v??dr.hidden;if(open&&!AUTHED){openLogin();return}dr.hidden=!open;if(open)drawDr();renderAll()}
$('#editBtn').addEventListener('click',()=>toggleDr(true));$('#drX').addEventListener('click',()=>toggleDr(false));
$('#undoB').addEventListener('click',()=>applyHist(-1));$('#redoB').addEventListener('click',()=>applyHist(1));
if(location.hash==='#editar')setTimeout(()=>toggleDr(true),50);

function f(label,path,o={}){const v=getp(S,path);const id='f-'+path.replace(/\./g,'-');const isA=Array.isArray(v);const val=isA?v.join('\n'):(v??'');
  const ctl=(o.rows||isA)?`<textarea id="${id}" rows="${o.rows||4}" data-b="${path}" ${isA?'data-k="lines"':''}>${esc(val)}</textarea>`:`<input id="${id}" type="${o.type||'text'}" value="${esc(val)}" data-b="${path}">`;
  return `<label class="fld" for="${id}"><span>${label}</span>${ctl}${o.hint?`<small>${o.hint}</small>`:''}</label>`}
const mv=(act,i,extra='')=>`<button class="ib" type="button" data-act="${act}-up" data-i="${i}" ${extra} aria-label="Subir">↑</button><button class="ib" type="button" data-act="${act}-down" data-i="${i}" ${extra} aria-label="Bajar">↓</button>`;

function drawDr(){
  $('#tabs').innerHTML=TABS.map(([k,l])=>`<button type="button" role="tab" class="${tab===k?'on':''}" data-tab="${k}">${l}</button>`).join('');
  const P={general:pGeneral,modulos:pMods,clientes:pClients,trabajos:pWorks,exp:pExp,skills:pSkills,estilo:pStyle,datos:pBackup};
  $('#drB').innerHTML=P[tab]();updUR();
}
function pGeneral(){const c=S.contact;return `
 <p class="help">Todo lo que cambies se guarda solo y se ve al instante en la web.</p>
 <h4>Logo y marca (arriba a la izquierda)</h4><div class="li">${S.brand.logo?`<img alt="Logo" src="${esc(S.brand.logo)}" style="width:auto;height:40px;max-width:120px;object-fit:contain;background:none">`:''}<div class="t" style="white-space:normal">${S.brand.logo?'Logo cargado':'Sin logo: se usa el hexágono'}<small>PNG, JPG o SVG. Mejor con fondo transparente.</small></div><button class="ib" type="button" data-act="logo-up">${S.brand.logo?'Cambiar':'Subir logo'}</button>${S.brand.logo?'<button class="ib del" type="button" data-act="logo-del">Quitar</button>':''}</div><label class="chk"><input type="checkbox" data-b="brand.showName" ${S.brand.showName!==false?'checked':''}><span>Mostrar el nombre al lado del logo</span></label>${f('Nombre','brand.name')}${f('Subtítulo','brand.sub')}
 <h4>Portada</h4>${f('Línea superior','hero.kicker')}${f('Título grande','hero.title',{hint:'Aparece palabra por palabra.'})}
 ${f('Palabras que van rotando después de “Hago”','hero.roles',{rows:6,hint:'Una por línea.'})}${f('Texto de presentación','hero.lead',{rows:4})}
 <h4>Números destacados</h4>${S.stats.map((s,i)=>`<div class="row2">${f('Número','stats.'+i+'.v')}${f('Texto','stats.'+i+'.l')}</div>`).join('')}
 <h4>Perfil</h4>${f('Perfil profesional','about.text',{rows:8})}${f('Marcas','about.brands',{rows:3,hint:'Una por línea.'})}${f('Países','about.countries',{rows:5,hint:'Una por línea.'})}
 <h4>Contacto</h4>${f('Email','contact.email',{type:'email'})}${f('Teléfono (como se muestra)','contact.phone')}${f('WhatsApp (solo números con código de país)','contact.whatsapp')}${f('Ubicación','contact.location')}${f('LinkedIn (link completo)','contact.linkedin',{type:'url'})}${f('Portfolio (link completo)','contact.site',{type:'url'})}
 <h4>Formación</h4>${f('Carrera','education.career')}${f('Institución','education.school')}${f('Período','education.period')}${f('Reconocimiento','education.recognition',{rows:3})}`}
function pMods(){return `<p class="help">Mostrá u ocultá cada sección, reordenala con las flechas y cambiale el nombre.</p>`+S.modules.map((m,i)=>`
 <div class="li ${m.on?'':'off'}"><div class="mrow" style="flex:1"><input type="text" value="${esc(m.label)}" data-b="modules.${i}.label" aria-label="Nombre de la sección"><span></span><span></span></div>
 <button class="ib ${m.on?'on':''}" type="button" data-act="mod-toggle" data-i="${i}">${m.on?'Visible':'Oculta'}</button>${mv('mod',i)}</div>`).join('')}
function pWorks(){
  if(editW!=null&&S.works[editW])return pWorkEdit(S.works[editW],editW);
  return `<p class="help">Creá grupos y, dentro de cada uno, sumá trabajos con sus imágenes y videos. Para videos pegá un link de YouTube o Google Drive; las imágenes las podés subir. Tocá la flecha de cada grupo para plegarlo.</p>
  <div class="acts"><button class="pbtn p" type="button" data-act="client-add">+ Nuevo grupo</button><button class="pbtn" type="button" data-act="work-add">+ Nuevo trabajo</button></div>
  ${f('Categorías','categories',{rows:6,hint:'Una por línea. Las primeras 7 forman el panal de la portada.'})}
  <h4>${S.works.length} trabajos, organizados en grupos</h4>`+groupWorks(S.works.map((w,i)=>{const m=w.media.map(parseMedia).filter(Boolean)[0];const p=coverSrc(w)||(m?poster(m):'');
   return {c:w.clientId,h:`<div class="li ${w.on?'':'off'}">${p?`<img alt="" src="${esc(p)}">`:'<img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==">'}<div class="t">${esc(w.title||'Sin título')}<small>${esc(w.cat)}${w.sample?' · ejemplo':''}</small></div>
   <button class="ib" type="button" data-act="work-edit" data-i="${i}">Editar</button>${mv('work',i)}</div>`}}))}
function groupWorks(items){const order=[...S.clients.map(c=>c.id),''];
  return order.map(id=>{const its=items.filter(x=>id===''?!S.clients.some(c=>c.id===x.c):x.c===id);const cl=S.clients.find(c=>c.id===id);
    if(id===''&&!its.length)return '';const op=!shut.has(id);
    return `<div class="ghd"><button class="ib" type="button" data-eg="${id}" aria-expanded="${op}" aria-label="${op?'Contraer':'Desplegar'} grupo">${op?'▾':'▸'}</button>${id===''?'<h4 style="flex:1">Sin grupo</h4>':`<input type="text" value="${esc(cl.name)}" data-b="clients.${S.clients.indexOf(cl)}.name" aria-label="Nombre del grupo">`}<small class="gcount">${its.length}</small><button class="ib" type="button" data-act="work-add" data-cl="${id}">+ Trabajo</button></div>${op?(its.length?its.map(x=>x.h).join(''):'<p class="help">Sin trabajos todavía.</p>'):''}`}).join('')}
function pClients(){return `<p class="help">Creá tus grupos y ordenalos. Después asignás cada trabajo a un grupo. Si ocultás un grupo, sus trabajos dejan de verse en la web, pero no se borran.</p><div class="acts"><button class="pbtn p" type="button" data-act="client-add">+ Nuevo grupo</button></div>`+
  (S.clients.length?S.clients.map((c,i)=>{const n=S.works.filter(w=>w.clientId===c.id).length;
   return `<div class="li ${c.on?'':'off'}"><div style="flex:1;min-width:0;display:grid;gap:2px"><input type="text" value="${esc(c.name)}" data-b="clients.${i}.name" aria-label="Nombre del grupo"><small style="color:var(--mut)">${n} ${n===1?'trabajo':'trabajos'}</small></div><button class="ib ${c.on?'on':''}" type="button" data-act="client-toggle" data-i="${i}">${c.on?'Visible':'Oculto'}</button>${mv('client',i)}<button class="ib del" type="button" data-act="client-del" data-i="${i}" aria-label="Eliminar">✕</button></div>`}).join(''):'<p class="help">Todavía no hay grupos.</p>')+'<p class="help">Al eliminar un grupo, sus trabajos pasan a “Sin grupo”.</p>'}
function pWorkEdit(w,i){const p='works.'+i;
  return `<div class="acts"><button class="pbtn" type="button" data-act="work-back">‹ Volver a la lista</button><button class="ib ${w.on?'on':''}" type="button" data-act="work-toggle" data-i="${i}">${w.on?'Visible':'Oculto'}</button><button class="ib del" type="button" data-act="work-del" data-i="${i}">Eliminar</button></div>
  ${f('Título',p+'.title')}
  <label class="fld"><span>Categoría</span><select data-b="${p}.cat">${[...new Set([...S.categories,w.cat])].map(c=>`<option ${c===w.cat?'selected':''}>${esc(c)}</option>`).join('')}</select></label>
  <div class="row2"><label class="fld"><span>Grupo</span><select data-b="${p}.clientId"><option value="">Sin grupo</option>${S.clients.map(c=>`<option value="${c.id}" ${c.id===w.clientId?'selected':''}>${esc(c.name)}${c.on?'':' (oculto)'}</option>`).join('')}</select></label>${f('Año',p+'.year')}</div>
  <h4>Carátula (miniatura)</h4>
  <p class="help">Es la imagen que se ve en la tarjeta de este trabajo. Se recorta al centro en formato 16:10 (ideal 1600×1000 px). Si no subís una, se usa el primer medio.</p>
  ${coverSrc(w)?`<div class="li"><img alt="" style="width:96px;height:60px" src="${esc(coverSrc(w))}"><div class="t">Carátula<small>${(w.cover||'').startsWith('data:')?'Subida desde tu equipo':'Desde un link'}</small></div><button class="ib del" type="button" data-act="cover-del" data-w="${i}">Quitar</button></div>`:''}
  <div class="acts"><button class="pbtn p" type="button" data-act="cover-up" data-w="${i}">${(w.cover||'').trim()?'Cambiar carátula':'Subir carátula'}</button></div>
  ${(w.cover||'').startsWith('data:')?'':`<label class="fld"><span>O pegá un link de imagen (Drive, YouTube o directo)</span><input type="text" data-b="${p}.cover" value="${esc(w.cover||'')}" placeholder="https://…"></label>`}
  <h4>Imágenes y videos (${w.media.length})</h4>
  <p class="help">Pegá un link de YouTube, de Google Drive (archivo compartido como “cualquier persona con el link”) o de una imagen o video directo. La primera es la miniatura.</p>
  ${w.media.map((m,j)=>m.url.startsWith('data:')?imgRow(m,j,i):`<div class="card2 ${m.on===false?'off':''}"><label class="fld"><span>Link ${j+1}</span><input type="text" id="m-${i}-${j}" value="${esc(m.url.startsWith('data:')?'(imagen subida)':m.url)}" ${m.url.startsWith('data:')?'readonly':''} data-b="${p}.media.${j}.url" placeholder="https://…"></label>
   <div class="mrow" style="grid-template-columns:1fr auto auto auto auto"><select data-b="${p}.media.${j}.type" aria-label="Tipo"><option value="" ${!m.type?'selected':''}>Tipo: automático</option><option value="image" ${m.type==='image'?'selected':''}>Es una imagen</option><option value="video" ${m.type==='video'?'selected':''}>Es un video</option></select>
   <button class="ib ${m.on===false?'':'on'}" type="button" data-act="media-toggle" data-i="${j}" data-w="${i}">${m.on===false?'Oculto':'Visible'}</button>${mv('media',j,`data-w="${i}"`)}<button class="ib del" type="button" data-act="media-del" data-i="${j}" data-w="${i}">✕</button></div>${mediaMeta(i,j,m)}</div>`).join('')}
  <div class="acts"><button class="pbtn p" type="button" data-act="media-add" data-w="${i}">+ Agregar link</button><button class="pbtn" type="button" data-act="upload" data-w="${i}">Subir imágenes</button></div><div class="drop" data-drop="${i}">Arrastrá acá todas las imágenes que quieras<small>Podés elegir varias a la vez. Se achican solas para que entren muchas.</small></div>`}
function imgRow(m,j,i){return `<div class="card2 ${m.on===false?'off':''}"><div class="li"><img alt="" src="${esc(m.url)}"><div class="t">Imagen ${j+1}<small>${j===0?'Miniatura del trabajo':'Subida desde tu equipo'}</small></div><button class="ib ${m.on===false?'':'on'}" type="button" data-act="media-toggle" data-i="${j}" data-w="${i}">${m.on===false?'Oculta':'Visible'}</button>${mv('media',j,`data-w="${i}"`)}<button class="ib del" type="button" data-act="media-del" data-i="${j}" data-w="${i}">✕</button></div>${mediaMeta(i,j,m)}</div>`}
function mediaMeta(i,j,m){return ''}
function pExp(){return `<p class="help">Tus trabajos anteriores.</p><div class="acts"><button class="pbtn p" type="button" data-act="exp-add">+ Nueva experiencia</button></div>`+
  S.experience.map((j,i)=>`<div class="card2"><div class="acts"><b style="flex:1;align-self:center">${esc(j.company||'Nueva')}</b>${mv('exp',i)}<button class="ib del" type="button" data-act="exp-del" data-i="${i}">✕</button></div>
  ${f('Empresa',`experience.${i}.company`)}${f('Puesto',`experience.${i}.role`)}${f('Período',`experience.${i}.period`)}${f('Tareas',`experience.${i}.bullets`,{rows:7,hint:'Una por línea.'})}</div>`).join('')}
function pSkills(){return `<p class="help">Grupos de competencias.</p><div class="acts"><button class="pbtn p" type="button" data-act="skill-add">+ Nuevo grupo</button></div>`+
  S.skills.map((g,i)=>`<div class="card2"><div class="acts"><b style="flex:1;align-self:center">${esc(g.title||'Nuevo')}</b>${mv('skill',i)}<button class="ib del" type="button" data-act="skill-del" data-i="${i}">✕</button></div>
  ${f('Título',`skills.${i}.title`)}${f('Ítems',`skills.${i}.items`,{rows:3,hint:'Separados por coma. El grupo 3 también corre en la cinta de la portada.'})}</div>`).join('')}
function pStyle(){return `<h4>Colores</h4><div class="colors"><label class="fld"><span>Rojo</span><input type="color" data-b="theme.red" value="${esc(S.theme.red)}"></label><label class="fld"><span>Cian</span><input type="color" data-b="theme.cyan" value="${esc(S.theme.cyan)}"></label></div>
  <label class="chk"><input type="checkbox" data-b="ui.noAnim" ${S.ui.noAnim?'checked':''}><span>Reducir animaciones</span></label>
  <label class="chk"><input type="checkbox" data-b="ui.hideEdit" ${S.ui.hideEdit?'checked':''}><span>Ocultar el botón “Editar” para los visitantes. Para volver a abrir este panel: Ctrl + Shift + E, o agregá #editar al final de la dirección.</span></label>`}
function pBackup(){
  if(VERS===undefined)loadVers();
  const fmt=t=>new Date(t).toLocaleString('es-AR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
  const list=VERS===undefined?'<p class="help">Cargando versiones…</p>':VERS===null?'<p class="help">Este navegador no permite guardar versiones. Usá la copia en archivo de más abajo.</p>':(VERS.length?VERS.map(v=>`<div class="card2"><div style="display:flex;justify-content:space-between;gap:8px"><b style="min-width:0;overflow-wrap:anywhere">${esc(v.label)}</b><small style="color:var(--mut);white-space:nowrap">${fmt(v.t)}</small></div><div class="acts"><button class="pbtn p" type="button" data-act="ver-restore" data-id="${v.id}">Restaurar todo</button><button class="pbtn" type="button" data-act="ver-look" data-id="${v.id}">Solo apariencia</button><button class="ib del" type="button" data-act="ver-del" data-id="${v.id}">Eliminar</button></div></div>`).join(''):'<p class="help">Todavía no guardaste versiones.</p>');
  return `<h4>Deshacer y rehacer</h4><p class="help">Los botones ↶ ↷ de arriba van hacia atrás y adelante en tus cambios (también Ctrl+Z y Ctrl+Y fuera de los campos de texto). Se reinician al cerrar la página; para dejar un punto seguro usá versiones.</p>
  <h4>Versiones guardadas</h4><p class="help">Una versión es una foto completa de tu web. Antes de editar y antes de restaurar se guarda una automática. “Solo apariencia” restaura colores, portada, módulos y marca sin tocar tus trabajos.</p>
  <div class="row2" style="grid-template-columns:1fr auto"><input type="text" id="verName" placeholder="Nombre (opcional)" aria-label="Nombre de la versión"><button class="pbtn p" type="button" data-act="ver-save">Guardar versión</button></div>${list}<h4>Copia en archivo</h4>`+pData()}
function pData(){const j=JSON.stringify(S);const kb=Math.round(new Blob([j]).size/1024);
  return `<p class="help">Tus cambios viven en este navegador. Descargá una copia de seguridad cada tanto, por si borrás los datos del navegador o querés abrir la web en otra computadora.</p>
  <p class="help">Espacio usado: ${kb} KB de unos 5000 KB disponibles. Las imágenes subidas pesan; los links de Drive y YouTube casi no. Para publicar: descargá la copia (se llama portfolio.json) y subila a tu hosting junto a index.html. Los videos y archivos pesados van en YouTube, Drive o un almacenamiento propio, y acá solo pegás el link.</p>
  <div class="acts"><button class="pbtn p" type="button" data-act="export">Descargar copia</button><button class="pbtn" type="button" data-act="copyjson">Copiar copia</button><button class="pbtn" type="button" data-act="import">Cargar copia</button></div>
  <label class="fld"><span>O pegá una copia acá</span><textarea id="pasteJson" rows="5" placeholder='{"brand":…}'></textarea></label>
  <div class="acts"><button class="pbtn" type="button" data-act="import-paste">Cargar lo pegado</button><button class="pbtn" type="button" data-act="reset">Volver al contenido inicial</button></div>
  <h4>Acceso al editor</h4>
  <p class="help">Usuario y contraseña para entrar al editor desde tu web publicada (link con #editar al final, o Ctrl + Shift + E). Usá una contraseña larga que no uses en otros sitios. El cambio vale en la web publicada cuando subís la nueva copia (portfolio.json).</p>
  <label class="fld"><span>Usuario nuevo</span><input id="nuU" type="text" autocomplete="off" autocapitalize="none" spellcheck="false"></label>
  <label class="fld"><span>Contraseña nueva</span><input id="nuP" type="password" autocomplete="new-password"></label>
  <div class="acts"><button class="pbtn p" type="button" data-act="auth-set">Guardar acceso</button><button class="pbtn" type="button" data-act="logout">Cerrar sesión</button></div>`}

let confirmReset=false;
dr.addEventListener('input',e=>{const t=e.target.closest('[data-b]');if(!t)return;let v=t.value;
  if(t.type==='checkbox')v=t.checked;else if(t.dataset.k==='lines')v=v.split('\n').map(s=>s.trim()).filter(Boolean);
  setp(S,t.dataset.b,v);const m=t.dataset.b.match(/^works\.(\d+)\./);if(m)S.works[m[1]].sample=false;
  if(t.dataset.b==='categories')S.categories=S.categories;touch()});
dr.addEventListener('click',e=>{
  const eg=e.target.closest('[data-eg]');if(eg){const id=eg.dataset.eg;shut.has(id)?shut.delete(id):shut.add(id);drawDr();return}
  const tb=e.target.closest('[data-tab]');if(tb){tab=tb.dataset.tab;editW=null;drawDr();return}
  const b=e.target.closest('[data-act]');if(!b)return;const a=b.dataset.act,i=+b.dataset.i,wi=b.dataset.w!=null?+b.dataset.w:null;
  const swap=(arr,i,d)=>{const j=i+d;if(j<0||j>=arr.length)return;[arr[i],arr[j]]=[arr[j],arr[i]]};
  const LIST={mod:S.modules,work:S.works,exp:S.experience,skill:S.skills,client:S.clients};
  const m=a.match(/^(mod|work|exp|skill|media|client)-(up|down)$/);
  if(m){const d=m[2]==='up'?-1:1;
    if(m[1]==='work'){const cid=S.works[i].clientId;let j=i+d;while(j>=0&&j<S.works.length&&S.works[j].clientId!==cid)j+=d;if(j>=0&&j<S.works.length)[S.works[i],S.works[j]]=[S.works[j],S.works[i]]}
    else swap(m[1]==='media'?S.works[wi].media:LIST[m[1]],i,d)}
  else if(a==='client-add'){S.clients.push({id:uid(),name:'Nuevo grupo',on:true})}
  else if(a==='client-toggle')S.clients[i].on=!S.clients[i].on;
  else if(a==='client-del'){if(b.dataset.sure){const id=S.clients[i].id;S.works.forEach(w=>{if(w.clientId===id)w.clientId=''});S.clients.splice(i,1)}else{b.dataset.sure=1;b.textContent='Tocá otra vez';return}}
  else if(a==='mod-toggle')S.modules[i].on=!S.modules[i].on;
  else if(a==='work-toggle')S.works[i].on=!S.works[i].on;
  else if(a==='work-add'){S.works.unshift({id:uid(),title:'Nuevo trabajo',cat:S.categories[0]||'General',clientId:b.dataset.cl||'',year:'',tags:'',desc:'',media:[{url:'',type:''}],on:true,sample:false});editW=0;selC.clear();selK.clear()}
  else if(a==='work-edit')editW=i;
  else if(a==='work-back')editW=null;
  else if(a==='work-del'){if(b.dataset.sure){S.works.splice(i,1);editW=null}else{b.dataset.sure=1;b.textContent='Tocá otra vez para borrar';return}}
  else if(a==='media-add')S.works[wi].media.push({url:'',type:'',on:true,desc:'',tags:''});
  else if(a==='media-toggle'){const mm=S.works[wi].media[i];mm.on=(mm.on===false)}
  else if(a==='logo-up'){$('#upLogo').click();return}
  else if(a==='logo-del')S.brand.logo='';
  else if(a==='ver-save'){const nm=$('#verName').value.trim();addVersion(nm||'Versión '+new Date().toLocaleString('es-AR'),JSON.stringify(S),false).then(ok=>toast(ok?'Versión guardada':'No se pudo guardar la versión'));return}
  else if(a==='ver-restore'||a==='ver-look'){const v=(VERS||[]).find(x=>x.id===b.dataset.id);if(!v)return;if(!b.dataset.sure){b.dataset.sure=1;b.textContent='Tocá otra vez para confirmar';return}restoreVer(v,a==='ver-look');return}
  else if(a==='ver-del'){if(!b.dataset.sure){b.dataset.sure=1;b.textContent='Tocá otra vez';return}IDB.del(b.dataset.id).then(loadVers);return}
  else if(a==='media-del')S.works[wi].media.splice(i,1);
  else if(a==='upload'){editW=wi;$('#upImg').click();return}
  else if(a==='cover-up'){editW=wi;$('#upCover').click();return}
  else if(a==='cover-del')S.works[wi].cover='';
  else if(a==='exp-add')S.experience.unshift({company:'Empresa',role:'Puesto',period:'',bullets:[]});
  else if(a==='exp-del')S.experience.splice(i,1);
  else if(a==='skill-add')S.skills.push({title:'Nuevo grupo',items:''});
  else if(a==='skill-del')S.skills.splice(i,1);
  else if(a==='auth-set'){setAuth();return}
  else if(a==='logout'){logout();return}
  else if(a==='export'){const blob=new Blob([JSON.stringify(S,null,1)],{type:'application/json'});const u=URL.createObjectURL(blob);const l=document.createElement('a');l.href=u;l.download='portfolio.json';document.body.append(l);l.click();l.remove();toast('Si no se descargó, usá “Copiar copia”.');return}
  else if(a==='copyjson'){copy(JSON.stringify(S));return}
  else if(a==='import'){$('#upJson').click();return}
  else if(a==='import-paste'){importJSON($('#pasteJson').value);return}
  else if(a==='reset'){if(b.dataset.sure){S=clone(DEFAULTS);save()}else{b.dataset.sure=1;b.textContent='Tocá otra vez para confirmar';return}}
  save();drawDr();renderAll()});
function importJSON(t){try{const o=JSON.parse(t);if(!o||typeof o!=='object'||!o.hero||!o.works)throw 0;S=Object.assign(clone(DEFAULTS),migrate(o));save();drawDr();renderAll();toast('Copia cargada')}catch(e){toast('Ese texto no parece una copia válida')}}
$('#upJson').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;f.text().then(importJSON);e.target.value=''});
async function addFiles(files,wi){const w=S.works[wi];if(!w)return;const imgs=[...files].filter(f=>f.type.startsWith('image/'));if(!imgs.length){toast('Solo se pueden subir imágenes. Para videos usá un link de YouTube o Drive.');return}
  w.media=w.media.filter(m=>m.url);let n=0;toast('Subiendo '+imgs.length+(imgs.length===1?' imagen…':' imágenes…'));
  for(const f of imgs){try{w.media.push({url:await shrink(f),type:'image'});n++}catch(err){toast('No pude leer '+f.name)}}
  w.sample=false;save();drawDr();renderAll();const kb=Math.round(new Blob([JSON.stringify(S)]).size/1024);
  toast(n+(n===1?' imagen agregada':' imágenes agregadas')+(kb>3800?'. Estás cerca del límite de espacio: usá links de Drive para el resto.':''))}
$('#upImg').addEventListener('change',e=>{addFiles(e.target.files,editW);e.target.value=''});
function coverData(file){return new Promise((ok,no)=>{const r=new FileReader();r.onerror=no;r.onload=()=>{const im=new Image();im.onerror=no;im.onload=()=>{const R=1.6;let cw=im.width,ch=im.height;if(cw/ch>R)cw=ch*R;else ch=cw/R;const ow=Math.min(1280,Math.round(cw)),oh=Math.round(ow/R),c=document.createElement('canvas');c.width=ow;c.height=oh;c.getContext('2d').drawImage(im,(im.width-cw)/2,(im.height-ch)/2,cw,ch,0,0,ow,oh);ok(c.toDataURL('image/jpeg',.82))};im.src=r.result};r.readAsDataURL(file)})}
$('#upCover').addEventListener('change',async e=>{const f=e.target.files[0];e.target.value='';if(!f||editW==null||!S.works[editW])return;if(!f.type.startsWith('image/')){toast('La carátula tiene que ser una imagen');return}try{S.works[editW].cover=await coverData(f);S.works[editW].sample=false;save();drawDr();renderAll();toast('Carátula actualizada')}catch(err){toast('No pude leer esa imagen')}});
dr.addEventListener('dragover',e=>{const d=e.target.closest('[data-drop]');if(d){e.preventDefault();d.classList.add('over')}});
dr.addEventListener('dragleave',e=>{const d=e.target.closest('[data-drop]');if(d)d.classList.remove('over')});
dr.addEventListener('drop',e=>{const d=e.target.closest('[data-drop]');if(!d)return;e.preventDefault();d.classList.remove('over');addFiles(e.dataTransfer.files,+d.dataset.drop)});
function shrink(file){return new Promise((ok,no)=>{const r=new FileReader();r.onerror=no;r.onload=()=>{const im=new Image();im.onerror=no;im.onload=()=>{const k=Math.min(1,1280/im.width);const c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.78))};im.src=r.result};r.readAsDataURL(file)})}

$('#upLogo').addEventListener('change',async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;try{S.brand.logo=await logoData(f);save();drawDr();renderAll()}catch(err){toast('No pude usar ese archivo como logo')}});
function logoData(f){return new Promise((ok,no)=>{const r=new FileReader();r.onerror=no;r.onload=()=>{if(f.type==='image/svg+xml'){f.size>400000?no():ok(r.result);return}const im=new Image();im.onerror=no;im.onload=()=>{const k=Math.min(1,160/im.height);const c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);ok(c.toDataURL('image/png'))};im.src=r.result};r.readAsDataURL(f)})}
{const pg=document.querySelector('.prog');let tk=0;addEventListener('scroll',()=>{if(tk)return;tk=requestAnimationFrame(()=>{tk=0;const h=document.documentElement.scrollHeight-innerHeight;pg.style.setProperty('--p',h>0?Math.min(1,scrollY/h):0)})},{passive:true})}
/* Publicación: los cambios del editor viven solo en el navegador de quien edita. Si no hay copia local, se lee portfolio.json (subido junto a este archivo) para que todos los visitantes vean tus trabajos. */
try{if(!localStorage.getItem(KEY)){fetch('portfolio.json',{cache:'no-cache'}).then(r=>r.ok?r.json():null).then(o=>{if(o&&o.hero&&o.works){S=Object.assign(clone(DEFAULTS),migrate(o));renderAll()}}).catch(()=>{})}}catch(e){}
renderAll();
function hashGate(){if(location.hash==='#editar'){history.replaceState(null,'',location.pathname+location.search);toggleDr(true)}}
addEventListener('hashchange',hashGate);hashGate();
})();
</script>
</body></html>