/* Acceso al editor: usuario y contraseña (se guardan como hash, nunca en texto). Es una barrera de interfaz: lo que ven los demás solo cambia si subís un nuevo portfolio.json a tu hosting. */
const AUTH0={s:'4e30ccb7ab51b145',h:'449227fe0a298aae4aa7be430627b1444253c8047ce5a0cc05fd95bffc603fb8'};
async function sha(t){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
const authHash=(s,u,p)=>sha(s+'|'+u.trim().toLowerCase()+'|'+p);
let lgFails=0;
function openLogin(){const lg=$('#lg');lg.hidden=false;$('#lgSh').checked=false;$('#lgP').type='password';$('#lgE').hidden=true;$('#lgP').value='';setTimeout(()=>$('#lgU').focus(),30)}
function closeLogin(){$('#lg').hidden=true}
$('#lgNo').addEventListener('click',closeLogin);
$('#lgSh').addEventListener('change',e=>{$('#lgP').type=e.target.checked?'text':'password'});
$('#lg').addEventListener('click',e=>{if(e.target.id==='lg')closeLogin()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#lg').hidden)closeLogin()});
async function doLogin(){const go=$('#lgGo'),er=$('#lgE');if(go.disabled)return;go.disabled=true;
  try{if(!(window.crypto&&crypto.subtle))throw 0;const a=S.auth&&S.auth.h?S.auth:AUTH0;const pv=$('#lgP').value;const ok=(await authHash(a.s,$('#lgU').value,pv))===a.h||(await authHash(a.s,$('#lgU').value,pv.trim()))===a.h;
    if(ok){lgFails=0;AUTHED=true;try{localStorage.setItem(KEY+'-ok','1')}catch(x){}closeLogin();$('#lgP').value='';toggleDr(true);if(!(S.auth&&S.auth.h))toast('Cambiá la contraseña inicial en Copias › Acceso al editor');go.disabled=false;return}
    lgFails++;er.textContent='Usuario o contraseña incorrectos.'}
  catch(x){er.textContent='No pude verificar el acceso. Abrí la web desde su link https.'}
  er.hidden=false;setTimeout(()=>{go.disabled=false},Math.min(lgFails*800,6000))}
/* sin <form>: el visor de Claude bloquea el envío de formularios, así que se usa el clic y la tecla Enter */
$('#lgGo').addEventListener('click',doLogin);
['#lgU','#lgP'].forEach(q=>$(q).addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();doLogin()}}));
async function setAuth(){const u=($('#nuU').value||'').trim(),p=$('#nuP').value||'';
  if(u.length<3){toast('El usuario necesita al menos 3 caracteres');return}
  if(p.length<8){toast('La contraseña necesita al menos 8 caracteres');return}
  if(!(window.crypto&&crypto.subtle)){toast('Este navegador no puede guardar el acceso');return}
  const s=[...crypto.getRandomValues(new Uint8Array(8))].map(x=>x.toString(16).padStart(2,'0')).join('');
  S.auth={s,h:await authHash(s,u,p)};save();drawDr();toast('Acceso actualizado. Descargá y subí la nueva copia para que valga en la web publicada')}
function logout(){AUTHED=false;try{localStorage.removeItem(KEY+'-ok')}catch(e){}toggleDr(false);renderAll();toast('Sesión cerrada')}
function copy(t,btn){const ok=()=>toast('Copiado');try{navigator.clipboard.writeText(t).then(ok,()=>fb())}catch(e){fb()}
  function fb(){const a=document.createElement('textarea');a.value=t;a.style.cssText='position:fixed;opacity:0';document.body.append(a);a.select();let r=false;try{r=document.execCommand('copy')}catch(e){}a.remove();if(r)ok();else{const q=$('#pasteJson');if(q){q.value=t;q.focus();q.select();toast('Texto listo en el recuadro: copialo con Ctrl + C')}else toast('No se pudo copiar')}}}

/* ---------- medios ---------- */
function parseMedia(m){if(m.on===false)return null;const r=parseMedia0(m);if(r)r.m=m;return r}
function parseMedia0(m){
  const u=(m.url||'').trim(); if(!u)return null; let x;
  if(x=u.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/))([\w-]{11})/))return{k:'yt',id:x[1]};
  if(x=u.match(/drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?(?:export=\w+&)?id=|thumbnail\?id=)([\w-]{10,})/))return{k:m.type==='video'?'drive-v':'drive-i',id:x[1]};
  if(m.type==='video'||/\.(mp4|webm|mov|m4v)(\?|$)/i.test(u))return{k:'file-v',u};
  return{k:'img',u};
}
const poster=m=>m.k==='yt'?`https://img.youtube.com/vi/${m.id}/hqdefault.jpg`:m.k.startsWith('drive')?`https://drive.google.com/thumbnail?id=${m.id}&sz=w1600`:m.k==='img'?m.u:'';
const isVid=m=>['yt','drive-v','file-v'].includes(m.k);
/* carátula propia del trabajo (subida o link); si no hay, se usa el primer medio */
function coverSrc(w){const u=(w.cover||'').trim();if(!u)return '';if(u.startsWith('data:'))return u;const c=parseMedia0({url:u,type:'image'});return c?poster(c):''}
const ytSrc=(id,snd,ctl)=>`https://www.youtube.com/embed/${id}?autoplay=1&mute=${snd?0:1}&loop=1&playlist=${id}&controls=${ctl?1:0}&rel=0&playsinline=1&modestbranding=1`;
function hue(str){let h=0;for(const c of str)h=(h*31+c.charCodeAt(0))>>>0;return h%4}
const COVERS=[['#ff3d54','#5b1230'],['#27d7f2','#0d3a7a'],['#7a5cff','#ff3d54'],['#0d3a7a','#ff3d54']];
function coverHTML(w){const [a,b]=COVERS[hue(w.cat+w.title)];return `<div class="cover" style="--c1:${a};--c2:${b}"></div>`}
function thumbHTML(w){
  const m=w.media.map(parseMedia).filter(Boolean)[0]; let inner=coverHTML(w); let badge='';const cs=coverSrc(w);if(cs)inner+=`<img loading="lazy" alt="${esc(w.title)}" src="${esc(cs)}">`;
  if(m){ if(cs){} else if(m.k==='yt')inner+=`<div class="yt" data-yt="${m.id}" style="background-image:url(${poster(m)})"></div>`;
    else if(m.k==='file-v')inner+=`<video data-auto muted loop playsinline preload="metadata" src="${esc(m.u)}"></video>`;
    else inner+=`<img loading="lazy" alt="${esc(w.title)}" src="${esc(poster(m))}">`;
    if(isVid(m))badge='<span class="badge r">Video</span>'; }
  if(w.sample)badge+='<span class="badge">Ejemplo</span>';
  return `<div class="thumb">${inner}${badge}</div>`;
}
function mediaFull(m,w,snd){
  if(!m){const cs=coverSrc(w);return cs?`<img alt="${esc(w.title)}" src="${esc(cs)}">`:coverHTML(w)}
  if(m.k==='yt')return `<iframe src="${ytSrc(m.id,snd,true)}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen title="${esc(w.title)}"></iframe>`;
  if(m.k==='drive-v')return `<iframe src="https://drive.google.com/file/d/${m.id}/preview" allow="autoplay; fullscreen" allowfullscreen title="${esc(w.title)}"></iframe>`;
  if(m.k==='drive-i')return `<img data-drive="${m.id}" src="${poster(m)}" alt="${esc(w.title)}">`;
  if(m.k==='file-v')return `<video src="${esc(m.u)}" autoplay loop playsinline controls ${snd?'':'muted'}></video>`;
  return `<img src="${esc(m.u)}" alt="${esc(w.title)}">`;
}
document.addEventListener('error',e=>{const t=e.target;if(t.tagName!=='IMG')return;
  if(t.dataset.drive&&t.closest('.lb-stage')){t.closest('.lb-stage').classList.remove('scroll');$('#lbView').hidden=true;t.outerHTML=`<iframe src="https://drive.google.com/file/d/${t.dataset.drive}/preview" allow="autoplay; fullscreen" allowfullscreen></iframe>`}
  else if(!t.closest('.lb-th'))t.remove()},true);

