<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>[hidden]{display:none!important}body{margin:0}</style><title>Stiven Cruz Portfolio</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="theme-color" content="#060b1d">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Sans:wght@400;500;700&display=swap">
<style>
/* Concepto: web oscura azul marino con panal de hexágonos como motivo (cada disciplina es una celda), rojo y cian como únicos acentos. */
:root{
  --bg:#060b1d; --bg2:#0a1330; --panel:#0d1838; --panel2:#132250; --line:#22346b;
  --fg:#eaf0ff; --mut:#8fa0cc; --red:#ff3d54; --cyan:#27d7f2;
  --display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --body:'DM Sans','Segoe UI',system-ui,sans-serif;
  --hw:128px; --ease:cubic-bezier(.2,.8,.2,1);
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg); color:var(--fg); font-family:var(--body); font-size:16px; line-height:1.6;
  padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:0; overflow-x:hidden; margin:0;
}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}
.glow{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
   radial-gradient(60vw 50vh at 8% -5%,color-mix(in srgb,var(--red) 20%,transparent),transparent 70%),
   radial-gradient(55vw 50vh at 100% 25%,color-mix(in srgb,var(--cyan) 14%,transparent),transparent 70%),
   radial-gradient(50vw 40vh at 30% 110%,color-mix(in srgb,var(--cyan) 10%,transparent),transparent 70%)}
.wrap{max-width:1180px;margin-inline:auto;position:relative;z-index:1}
a{color:inherit}
h1,h2,h3,h4{font-family:var(--display);margin:0;text-wrap:balance;line-height:1.05;letter-spacing:-.02em}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;border-radius:6px}
.hex{clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}

/* barra */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;margin-inline:calc(-1*max(16px,env(safe-area-inset-left,0px)));padding-inline:max(16px,env(safe-area-inset-left,0px));
  background:color-mix(in srgb,var(--bg) 78%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent)}
.bar-in{max-width:1180px;margin:auto;display:flex;align-items:center;gap:18px;height:64px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;flex:none}
.logo svg{width:34px;height:34px;flex:none}
.logo-img{height:38px;width:auto;max-width:160px;object-fit:contain;flex:none}
.dr-x:disabled{opacity:.35;cursor:default}
.logo b{display:block;font-family:var(--display);font-size:1.02rem;line-height:1.05;letter-spacing:-.01em}
.logo small{display:block;font-size:.68rem;color:var(--mut);letter-spacing:.08em;text-transform:uppercase}
.nav{display:flex;gap:4px;margin-left:auto;overflow:auto;scrollbar-width:none}
.nav a{padding:8px 12px;border-radius:99px;text-decoration:none;font-size:.88rem;color:var(--mut);white-space:nowrap;transition:.25s}
.nav a.on{color:var(--fg);background:color-mix(in srgb,var(--panel2) 80%,transparent)}
.search{position:relative;flex:0 1 220px;min-width:0}
.search input{width:100%;height:38px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--fg);padding:0 14px 0 36px;font:inherit;font-size:.9rem}
.search input::placeholder{color:var(--mut)}
.search svg{position:absolute;left:12px;top:50%;translate:0 -50%;width:16px;height:16px;color:var(--mut)}
.edit-btn{flex:none;height:38px;padding:0 16px;border-radius:99px;border:1px solid color-mix(in srgb,var(--red) 60%,transparent);background:color-mix(in srgb,var(--red) 14%,transparent);font-weight:700;font-size:.85rem}

@media(max-width:900px){.nav{display:none}.search{margin-left:auto}}
@media(max-width:520px){.logo small{display:none}.search{flex-basis:120px}.edit-btn{padding:0 12px}}

/* secciones */
.sec{padding-block:clamp(60px,9vw,112px);scroll-margin-top:64px}
.eyebrow{display:flex;align-items:center;gap:10px;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin-bottom:14px}
.eyebrow i{width:14px;height:16px;background:var(--red);display:block}
.sec h2{font-size:clamp(2.2rem,5.5vw,4rem);font-weight:700;margin-bottom:clamp(28px,4vw,48px)}
.rv{opacity:0;transform:translateY(20px);transition:opacity .7s var(--ease),transform .7s var(--ease);transition-delay:calc(var(--d,0)*70ms)}
.rv.in{opacity:1;transform:none}
html.noanim .rv{opacity:1;transform:none;transition:none}

/* portada */
.hero{padding-block:clamp(36px,6vw,80px) 0;position:relative}
.hero-in{display:grid;grid-template-columns:1.15fr .85fr;gap:30px;align-items:center}
@media(max-width:900px){.hero-in{grid-template-columns:1fr}}
.kicker{display:inline-flex;align-items:center;gap:10px;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);font-weight:700;margin:0 0 22px}
.kicker i{width:34px;height:2px;background:var(--red)}
.hero h1{font-size:clamp(3.4rem,10.5vw,8.4rem);font-weight:800;line-height:.92;letter-spacing:-.04em}
.wm{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-right:.2em}
.w{display:inline-block;transform:translateY(105%);animation:up .95s var(--ease) forwards;animation-delay:calc(var(--i)*110ms + 120ms)}
.hero h1 .wm:nth-child(even) .w{background:linear-gradient(100deg,var(--red),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}
@keyframes up{to{transform:none}}
.role{margin:26px 0 0;font-size:clamp(1.15rem,2.4vw,1.6rem);display:flex;gap:.5em;flex-wrap:wrap;align-items:baseline}
.role span.pre{color:var(--mut)}
.rot{display:inline-block;font-family:var(--display);font-weight:700;color:var(--fg);border-bottom:3px solid var(--red);padding-bottom:1px;animation:swap .6s var(--ease)}
@keyframes swap{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.lead{max-width:56ch;color:var(--mut);margin:22px 0 0;font-size:1.05rem}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:99px;background:var(--red);color:#fff;text-decoration:none;font-weight:700;border:1px solid var(--red);transition:.3s var(--ease)}

.btn.ghost{background:transparent;border-color:var(--line);color:var(--fg)}

.stats{display:flex;gap:clamp(18px,4vw,44px);flex-wrap:wrap;margin:38px 0 0;padding:0}
.stats div{display:flex;flex-direction:column}
.stats dt{font-family:var(--display);font-size:clamp(2rem,4vw,2.9rem);font-weight:800;line-height:1;order:1}
.stats dd{margin:6px 0 0;color:var(--mut);font-size:.85rem;order:2;max-width:14ch}

/* panal */
.honey{position:relative;margin:auto;width:calc(var(--hw)*2.0667 + var(--hw));height:calc(var(--hw)*2.887);max-width:100%}
.cell{position:absolute;width:var(--hw);height:calc(var(--hw)*1.1547);left:calc(var(--hw)*1.0333*var(--x));top:calc(var(--hw)*.866*var(--y));
  border:0;padding:0;background:linear-gradient(145deg,var(--red),var(--cyan));clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);
  animation:float 6s ease-in-out infinite;animation-delay:calc(var(--n)*-.9s);transition:filter .3s,scale .4s var(--ease)}
.cell::before{content:"";position:absolute;inset:3px;background:var(--panel);clip-path:inherit;transition:background .3s}

.cell.core::before{background:color-mix(in srgb,var(--red) 28%,var(--panel))}
.cell span{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:0 16%;text-align:center;font-family:var(--display);font-weight:700;font-size:calc(var(--hw)*.115);line-height:1.1}
.cell small{font-family:var(--body);font-weight:500;color:var(--mut);font-size:calc(var(--hw)*.092);margin-top:4px}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -9px}}
.hero-art{display:flex;justify-content:center;padding-block:10px}
@media(max-width:480px){:root{--hw:100px}}
@media(max-width:360px){:root{--hw:88px}}

.marquee{margin-top:clamp(44px,7vw,84px);margin-inline:calc(-1*max(16px,env(safe-area-inset-left,0px)));overflow:hidden;border-block:1px solid var(--line);background:color-mix(in srgb,var(--bg2) 70%,transparent);padding-block:16px;position:relative;z-index:1}
.track{display:flex;gap:40px;width:max-content;animation:mq 38s linear infinite}
.track span{display:inline-flex;align-items:center;gap:40px;font-family:var(--display);font-weight:600;font-size:1.25rem;color:var(--mut);white-space:nowrap}
.track span::after{content:"";width:12px;height:14px;background:var(--red);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
@keyframes mq{to{transform:translateX(-50%)}}

/* perfil */
.about{display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(28px,5vw,64px)}
@media(max-width:860px){.about{grid-template-columns:1fr}}
.about p.big{font-size:clamp(1.15rem,2.2vw,1.5rem);line-height:1.55;margin:0;font-family:var(--display);font-weight:500;letter-spacing:-.01em}
.box{border:1px solid var(--line);background:linear-gradient(180deg,var(--panel),var(--bg2));border-radius:18px;padding:24px}
.box h4{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:14px;font-family:var(--body);font-weight:700}
.box+.box{margin-top:16px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.chips li{padding:7px 14px;border-radius:99px;border:1px solid var(--line);background:var(--bg2);font-size:.9rem;transition:.25s}


/* trabajos */
.filters{display:grid;gap:14px;margin-bottom:28px}
.frow{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.fl{font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);font-weight:700;min-width:86px}
.chip{padding:8px 16px;border-radius:99px;border:1px solid var(--line);background:transparent;font-size:.88rem;transition:.25s}

.chip.on{background:var(--red);border-color:var(--red);color:#fff;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:22px}
.card{position:relative;text-align:left;border:1px solid var(--line);background:var(--panel);border-radius:18px;overflow:hidden;padding:0;display:flex;flex-direction:column;
  transition:transform .45s var(--ease),border-color .3s,box-shadow .4s;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg))}

.thumb{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--bg2)}
.thumb>*{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0}
.thumb .yt{background-size:cover;background-position:center}
.thumb iframe{pointer-events:none}
.thumb img,.thumb video{transition:transform .8s var(--ease)}

.cover{display:block;background:linear-gradient(135deg,var(--c1),var(--c2));overflow:hidden}
.cover::before{content:"";position:absolute;right:-12%;top:-18%;width:70%;aspect-ratio:1/1.1547;background:rgba(255,255,255,.1);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.cover::after{content:"";position:absolute;right:12%;top:30%;width:34%;aspect-ratio:1/1.1547;border:0;background:rgba(0,0,0,.2);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.cover b{position:relative;z-index:1;font-family:var(--display);font-size:1.5rem;line-height:1;letter-spacing:-.02em;text-shadow:0 2px 14px rgba(0,0,0,.35)}
.badge{position:absolute!important;inset:10px auto auto 10px!important;width:auto!important;height:auto!important;z-index:2;padding:4px 10px;border-radius:99px;background:rgba(6,11,29,.78);font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;backdrop-filter:blur(6px)}
.badge.r{inset:10px 10px auto auto!important;background:var(--red)}
.cinfo{padding:16px 18px 18px;display:flex;flex-direction:column;gap:4px}
.cinfo h3{font-size:1.2rem;letter-spacing:-.01em;line-height:1.15}
.cinfo p{margin:0;color:var(--mut);font-size:.85rem}
.empty{padding:48px 20px;text-align:center;border:1px dashed var(--line);border-radius:18px;color:var(--mut)}

.dr .ghd input{flex:1}.gcount{color:var(--mut)}
.secs{display:grid;gap:22px}
/* secciones con 5 trabajos o más: filas de 3 y la última fila centrada (CENTER_MIN en el código) */
.grid.mid{display:flex;flex-wrap:wrap;justify-content:center}
.grid.mid>.card{flex:0 0 calc((100% - 44px)/3);min-width:0}
@media(max-width:1035px){.grid.mid>.card{flex-basis:calc((100% - 22px)/2)}}
@media(max-width:693px){.grid.mid>.card{flex-basis:100%}}
.lg{position:fixed;inset:0;z-index:180;display:grid;place-items:center;padding:16px;background:rgba(3,6,18,.8);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.lg[hidden]{display:none}
.lgc{width:min(100%,360px);background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px;display:grid;gap:14px}
.lgc h2{font-size:1.3rem}.lgh{margin:0;color:var(--mut);font-size:.9rem}
.lgc label{display:grid;gap:6px;font-size:.85rem;color:var(--mut)}
.lgc input{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:10px;padding:12px 14px;color:var(--fg);font:inherit;font-size:16px}
.lgc input:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
.lg-err{margin:0;color:#ff8a98;font-size:.85rem}
.lgb{display:flex;gap:10px}
.lgc button{flex:1;padding:12px;border-radius:99px;border:1px solid var(--line);background:transparent;color:var(--fg);font-weight:700}
.lgc label.lgs{display:flex;align-items:center;gap:8px;font-size:.85rem}.lgc label.lgs input{width:auto;padding:0}
.lgc button.go{background:var(--red);border-color:var(--red);color:#fff}
.lgc button:disabled{opacity:.5}
/* experiencia */
.tl{position:relative;display:grid;gap:22px;padding-left:34px}
.tl::before{content:"";position:absolute;left:11px;top:8px;bottom:8px;width:2px;background:linear-gradient(var(--red),var(--cyan))}
.job{position:relative}
.job::before{content:"";position:absolute;left:-34px;top:22px;width:24px;height:27px;background:linear-gradient(145deg,var(--red),var(--cyan));clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.job::after{content:"";position:absolute;left:-29px;top:27px;width:14px;height:17px;background:var(--bg);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.job .box{padding:clamp(20px,3vw,32px)}
.jh{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 24px;margin-bottom:16px}
.jh h3{font-size:clamp(1.4rem,3vw,2rem)}
.jh p{margin:4px 0 0;color:var(--cyan);font-weight:700}
.per{font-size:.85rem;color:var(--mut);border:1px solid var(--line);padding:5px 14px;border-radius:99px;align-self:flex-start;white-space:nowrap}
.job ul{margin:0;padding:0;list-style:none;display:grid;gap:9px;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))}
.job li{position:relative;padding-left:22px;color:#c8d3f1}
.job li::before{content:"";position:absolute;left:0;top:.5em;width:9px;height:10px;background:var(--red);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}

/* competencias */
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:18px}
.skills .box{display:flex;flex-direction:column}
.skills h3{font-size:1.3rem;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.skills h3::before{content:"";width:14px;height:16px;flex:none;background:var(--red);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}

/* formación */
.edu{display:grid;grid-template-columns:auto 1fr;gap:clamp(18px,4vw,40px);align-items:center}
@media(max-width:620px){.edu{grid-template-columns:1fr}}
.edu .seal{width:clamp(110px,16vw,160px);aspect-ratio:1/1.1547;background:linear-gradient(145deg,var(--red),var(--cyan));clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:clamp(1.3rem,3vw,2rem);color:#fff;text-align:center;line-height:1.05}
.edu h3{font-size:clamp(1.5rem,3.4vw,2.3rem)}
.edu p{margin:8px 0 0;color:var(--mut)}
.edu .rec{margin-top:16px;display:inline-flex;gap:10px;align-items:center;padding:10px 16px;border-radius:12px;border:1px solid color-mix(in srgb,var(--cyan) 50%,transparent);background:color-mix(in srgb,var(--cyan) 8%,transparent);color:var(--fg)}

/* contacto */
.contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:16px}
.cc{display:flex;flex-direction:column;gap:6px;min-width:0}
.cc small{color:var(--cyan);letter-spacing:.12em;text-transform:uppercase;font-size:.72rem;font-weight:700}
.cc .v{font-family:var(--display);font-size:1.25rem;font-weight:600;overflow-wrap:anywhere;user-select:all}
.cc .act{display:flex;gap:8px;margin-top:6px;flex-wrap:wrap}
.mini{padding:6px 14px;border-radius:99px;border:1px solid var(--line);background:transparent;font-size:.82rem;text-decoration:none;transition:.25s}

footer{position:relative;z-index:1;border-top:1px solid var(--line);padding-block:30px;color:var(--mut);font-size:.88rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;max-width:1180px;margin:auto}

/* visor */
.lb{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:max(14px,env(safe-area-inset-top,0px)) max(14px,env(safe-area-inset-right,0px)) max(14px,env(safe-area-inset-bottom,0px)) max(14px,env(safe-area-inset-left,0px));animation:fade .3s}
@keyframes fade{from{opacity:0}}
.lb-bg{position:absolute;inset:0;background:rgba(3,6,18,.86);backdrop-filter:blur(8px)}
.lb-card{position:relative;width:min(1040px,100%);max-height:100%;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:20px;animation:pop .45s var(--ease)}
@keyframes pop{from{opacity:0;transform:translateY(24px) scale(.97)}}
.lb-stage{position:relative;aspect-ratio:16/9;max-height:64vh;width:100%;background:#000;display:grid;place-items:center;overflow:hidden}
.lb-stage>*{width:100%;height:100%;border:0;object-fit:contain}
.lb-stage .cover{position:relative}
.lb-stage.scroll{display:block;aspect-ratio:auto;height:auto;max-height:64vh;overflow-y:auto;overflow-x:hidden;background:var(--bg2);scrollbar-color:var(--red) var(--panel)}
.lb-stage.scroll>img{display:block;width:100%;height:auto;object-fit:initial}
.lb-sw{position:relative}
/* modos de imagen: FULL = completa, HORIZONTAL = a todo el ancho, VERTICAL = a todo el alto */
.lb-stage.scroll[data-view=f]{display:grid;place-items:center;height:64vh;max-height:64vh;overflow:hidden;background:#000}
.lb-stage.scroll[data-view=f]>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.lb-stage.scroll[data-view=v]{display:flex;height:64vh;max-height:64vh;overflow-x:auto;overflow-y:hidden}
.lb-stage.scroll[data-view=v]>img{flex:none;height:100%;width:auto;max-width:none;margin-inline:auto;object-fit:initial}
.lb-view{position:absolute;left:50%;bottom:18px;translate:-50% 0;z-index:3;display:flex;gap:2px;padding:3px;border-radius:99px;background:rgba(6,11,29,.82);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1px solid color-mix(in srgb,var(--line) 70%,transparent);max-width:calc(100% - 24px)}
.lb-view button{border:0;background:transparent;color:var(--mut);font-weight:700;font-size:.72rem;letter-spacing:.08em;padding:9px 14px;border-radius:99px;transition:background .25s,color .25s}
.lb-view button[aria-pressed=true]{background:var(--red);color:#fff}
@media(max-width:420px){.lb-view button{padding:9px 10px;font-size:.66rem;letter-spacing:.04em}}
@media (hover:hover) and (pointer:fine){.lb-view button:hover{color:var(--fg)}}
.lb-nav.next{right:22px!important}
.lb-x,.lb-nav,.lb-snd{position:absolute;z-index:3;border:0;background:rgba(6,11,29,.8);color:#fff;border-radius:99px;backdrop-filter:blur(6px)}
.lb-x{top:12px;right:12px;width:40px;height:40px;font-size:1.1rem}
.lb-nav{top:calc(min(64vh,56.25vw*0.9)/2);width:44px;height:44px;font-size:1.6rem;line-height:1}
.lb-nav.prev{left:12px}.lb-nav.next{right:12px}
.lb-snd{left:12px;top:12px;padding:9px 16px;font-size:.85rem;font-weight:700}

.lb-info{padding:clamp(18px,3vw,28px);display:grid;gap:10px}
.lb-info h3{font-size:clamp(1.5rem,3vw,2.1rem)}
.lb-meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:var(--mut);font-size:.9rem}
.lb-meta b{color:var(--cyan)}
.lb-cap{border-left:3px solid var(--red);padding:4px 0 4px 14px;display:grid;gap:8px}.lb-cap p{margin:0;white-space:pre-line;color:#c8d3f1}.lb-cap .chips li{font-size:.8rem;padding:4px 10px}
.card2.off{opacity:.55}
.lb-d{margin:0;color:#c8d3f1;max-width:75ch;white-space:pre-line}
.lb-th{display:flex;gap:10px;overflow-x:auto;padding-block:4px}
.lb-th button{flex:none;width:112px;aspect-ratio:16/10;border-radius:10px;overflow:hidden;border:2px solid transparent;padding:0;background:var(--bg2);position:relative;opacity:.65;transition:.25s}
.lb-th button.on{opacity:1;border-color:var(--red)}
.lb-th img,.lb-th video{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}

/* panel de edición */
.dr{overflow:hidden;position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);z-index:90;background:var(--bg2);border-left:1px solid var(--line);display:flex;flex-direction:column;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);padding-right:env(safe-area-inset-right,0px);box-shadow:-30px 0 60px -30px #000;animation:slide .4s var(--ease)}
@keyframes slide{from{transform:translateX(100%)}}
.dr-h{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
.dr-h h3{font-size:1.1rem;flex:1}
.saved{font-size:.78rem;color:var(--cyan)}
.dr-x{width:36px;height:36px;border-radius:99px;border:1px solid var(--line);background:transparent}
.tabs{display:flex;gap:4px;padding:10px 12px;overflow-x:auto;border-bottom:1px solid var(--line);scrollbar-width:none}
.tabs button{padding:8px 14px;border-radius:99px;border:0;background:transparent;color:var(--mut);white-space:nowrap;font-size:.88rem}
.tabs button.on{background:var(--red);color:#fff;font-weight:700}
.dr-b{flex:1;overflow:auto;padding:16px 16px 40px;display:grid;grid-template-columns:minmax(0,1fr);gap:12px;align-content:start}
.dr-b>*{min-width:0}
.dr .acts>*,.dr .card2>*{min-width:0}
.dr h4{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);margin-top:10px;font-family:var(--body)}
.help{margin:0;color:var(--mut);font-size:.88rem}
.fld{display:grid;gap:5px;min-width:0}
.fld>span{font-size:.82rem;color:var(--mut);font-weight:700}
.fld small{color:var(--mut);font-size:.76rem}
.dr input[type=text],.dr input[type=url],.dr input[type=email],.dr input:not([type]),.dr textarea,.dr select{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:10px;color:var(--fg);padding:10px 12px;font:inherit;font-size:.92rem;min-width:0}
.dr textarea{resize:vertical;line-height:1.45}
.drop{border:2px dashed var(--line);border-radius:14px;padding:22px 14px;text-align:center;color:var(--mut);font-size:.92rem;transition:.25s}.drop small{display:block;margin-top:4px;font-size:.78rem}.drop.over{border-color:var(--cyan);background:color-mix(in srgb,var(--cyan) 10%,transparent);color:var(--fg)}
.ghd{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px}.ghd h4{margin:0}
.row2{display:grid;grid-template-columns:1fr 1.6fr;gap:10px}
.li{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:8px 10px}
.li .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.92rem}
.li .t small{display:block;color:var(--mut);font-size:.76rem}
.li.off{opacity:.5}
.li img{width:52px;height:34px;object-fit:cover;border-radius:6px;flex:none;background:var(--bg)}
.ib{min-width:32px;height:32px;border-radius:8px;border:1px solid var(--line);background:transparent;font-size:.8rem;padding:0 8px;flex:none}


.ib.on{background:var(--cyan);color:#04101f;border-color:var(--cyan);font-weight:700}
.pbtn{padding:10px 16px;border-radius:10px;border:1px solid var(--line);background:var(--panel2);font-weight:700;font-size:.88rem}
.pbtn.p{background:var(--red);border-color:var(--red);color:#fff}

.acts{display:flex;gap:8px;flex-wrap:wrap}
.mrow{display:grid;grid-template-columns:1fr 120px auto;gap:6px;align-items:center}
.card2{border:1px solid var(--line);border-radius:14px;padding:12px;display:grid;gap:10px;background:color-mix(in srgb,var(--panel) 60%,transparent)}
.colors{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.colors input[type=color]{width:100%;height:44px;padding:2px;border-radius:10px;background:var(--panel);border:1px solid var(--line)}
.chk{display:flex;gap:10px;align-items:flex-start;font-size:.92rem}
.chk input{margin-top:4px;accent-color:var(--red)}
.toast{position:fixed;left:50%;bottom:max(20px,env(safe-area-inset-bottom,0px));translate:-50% 0;z-index:200;background:var(--panel2);border:1px solid var(--cyan);padding:12px 20px;border-radius:99px;font-size:.9rem;animation:fade .3s;max-width:calc(100% - 32px)}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .w{transform:none}.track{animation:none}.rv{opacity:1;transform:none}
}
html.noanim *,html.noanim *::before,html.noanim *::after{animation-duration:.01ms!important;animation-iteration-count:1!important}
html.noanim .w{transform:none}html.noanim .track{animation:none}

@media (hover:hover) and (pointer:fine){
.nav a:hover{color:var(--fg);background:color-mix(in srgb,var(--panel2) 80%,transparent)}
.edit-btn:hover{background:var(--red)}
.btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px -10px var(--red)}
.btn.ghost:hover{border-color:var(--cyan);box-shadow:0 12px 30px -12px var(--cyan)}
.cell:hover{scale:1.08;filter:drop-shadow(0 0 14px var(--cyan));z-index:3}
.cell:hover::before{background:color-mix(in srgb,var(--red) 28%,var(--panel))}
.chips li:hover{border-color:var(--red);transform:translateY(-2px)}
.chip:hover{border-color:var(--cyan)}
.card:hover{border-color:var(--cyan);box-shadow:0 24px 50px -24px var(--cyan)}
.card:hover .thumb img,.card:hover .thumb video{transform:scale(1.06)}
.mini:hover{border-color:var(--cyan);color:var(--cyan)}
.lb-x:hover,.lb-nav:hover,.lb-snd:hover{background:var(--red)}
.lb-th button:hover{opacity:1;border-color:var(--red)}
.ib:hover{border-color:var(--cyan)}
.ib.del:hover{border-color:var(--red);color:var(--red)}
.pbtn:hover{border-color:var(--cyan)}
}
/* móvil: sin parpadeo gris, toque inmediato, sin selección en controles */
html{-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%}
button,a,[role=button],.chip,.cell,.card{touch-action:manipulation}
button,.chip,.cell,.card,.btn{user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.btn:active,.chip:active,.pbtn:active,.ib:active,.mini:active,.edit-btn:active{transform:scale(.97)}
.card:active{scale:.98}.cell:active{scale:.94}
@media (pointer:coarse){.dr input,.dr textarea,.dr select,.search input{font-size:16px!important}}
.dr-b,.lb-card,.lb-stage.scroll{overscroll-behavior:contain}
/* datos largos: nada se sale de su caja */
.hero-in>*,.about>*,.edu>*,.grid>*{min-width:0}
.wm{max-width:100%}.w{max-width:100%;overflow-wrap:anywhere}
.cinfo h3,.cinfo p,.lb-info h3,.lb-meta,.jh h3,.jh p,.skills h3,.edu h3,.edu p,.chip,.chips li{overflow-wrap:anywhere}
.cinfo h3{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cinfo p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cell span{overflow:hidden;overflow-wrap:anywhere}
.per{white-space:normal}
.chip{max-width:100%;text-align:left}
.logo>span{min-width:0}.logo b,.logo small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:min(42vw,260px)}
@media(max-width:520px){.logo b{max-width:30vw}.search{flex:1 1 90px;min-width:70px}.bar-in{gap:10px}}
/* progreso de lectura */
.prog{position:absolute;left:0;right:0;bottom:-1px;height:2px;background:linear-gradient(90deg,var(--red),var(--cyan));transform-origin:0 50%;transform:scaleX(var(--p,0))}
</style>

</head><body><div class="glow" aria-hidden="true"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="hg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff3d54"/><stop offset="1" stop-color="#27d7f2"/></linearGradient></defs></svg>

<header class="bar"><i class="prog" aria-hidden="true"></i><div class="bar-in">
  <a class="logo" href="#hero" data-go="hero" aria-label="Inicio">
    <svg id="logoSvg" viewBox="0 0 24 27" aria-hidden="true"><polygon points="12,1 23,7 23,20 12,26 1,20 1,7" fill="url(#hg)"/><path d="M15.5 9.2c-.7-.9-1.8-1.4-3.2-1.4-1.9 0-3.1 1-3.1 2.4 0 3.2 6.2 1.8 6.2 5 0 1.5-1.4 2.5-3.3 2.5-1.5 0-2.8-.6-3.5-1.6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg><img id="logoImg" class="logo-img" alt="Logo" hidden>
    <span id="bTxt"><b id="bName"></b><small id="bSub"></small></span>
  </a>
  <nav class="nav" id="nav" aria-label="Secciones"></nav>
  <label class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="q" type="search" placeholder="Buscar trabajos" aria-label="Buscar trabajos" autocomplete="off"></label>
  <button class="edit-btn" id="editBtn" type="button">Editar</button>
</div></header>

<main class="wrap" id="main"></main>
<footer><span id="foot"></span><span>Hecho para mostrar el trabajo, no para depender de nadie.</span></footer>

<div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label="Detalle del trabajo">
  <div class="lb-bg" data-lb="close"></div>
  <div class="lb-card">
    <button class="lb-x" type="button" data-lb="close" aria-label="Cerrar">✕</button>
    <div class="lb-sw"><div class="lb-stage" id="lbStage"></div><div class="lb-view" id="lbView" role="group" aria-label="Modo de visualización" hidden><button type="button" data-view="f" aria-pressed="false">FULL</button><button type="button" data-view="h" aria-pressed="true">HORIZONTAL</button><button type="button" data-view="v" aria-pressed="false">VERTICAL</button></div></div>
    <button class="lb-snd" id="lbSnd" type="button" data-lb="snd" hidden></button>
    <button class="lb-nav prev" type="button" data-lb="prev" aria-label="Anterior">‹</button>
    <button class="lb-nav next" type="button" data-lb="next" aria-label="Siguiente">›</button>
    <div class="lb-info"><h3 id="lbT"></h3><div class="lb-meta" id="lbM"></div><p class="lb-d" id="lbD"></p><div class="lb-cap" id="lbCap" hidden></div><div class="lb-th" id="lbTh"></div></div>
  </div>
</div>

<aside class="dr" id="dr" hidden aria-label="Panel de edición">
  <div class="dr-h"><h3>Editar mi web</h3><span class="saved" id="saved"></span><button class="dr-x" type="button" id="undoB" aria-label="Deshacer" title="Deshacer">↶</button><button class="dr-x" type="button" id="redoB" aria-label="Rehacer" title="Rehacer">↷</button><button class="dr-x" type="button" id="drX" aria-label="Cerrar panel">✕</button></div>
  <div class="tabs" id="tabs" role="tablist"></div>
  <div class="dr-b" id="drB"></div>
</aside>
<input type="file" id="upImg" accept="image/*" multiple hidden>
<input type="file" id="upJson" accept="application/json,.json" hidden>
<input type="file" id="upLogo" accept="image/*" hidden>
<input type="file" id="upCover" accept="image/*" hidden>
<div class="lg" id="lg" hidden role="dialog" aria-modal="true" aria-labelledby="lgT"><div class="lgc" id="lgF"><h2 id="lgT">Acceso al editor</h2><p class="lgh">Solo para el dueño de la web.</p><label>Usuario<input id="lgU" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required></label><label>Contraseña<input id="lgP" name="password" type="password" autocomplete="current-password" required></label><label class="lgs"><input type="checkbox" id="lgSh"> Mostrar contraseña</label><p class="lg-err" id="lgE" role="alert" hidden></p><div class="lgb"><button type="button" class="go" id="lgGo">Entrar</button><button type="button" id="lgNo">Cancelar</button></div></div></div>

<script>
(()=>{
'use strict';
const KEY='stiven-cruz-portfolio-v1';
let AUTHED=false;try{AUTHED=localStorage.getItem(KEY+'-ok')==='1'}catch(e){}
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9);
const clone=o=>JSON.parse(JSON.stringify(o));
const getp=(o,p)=>p.split('.').reduce((a,k)=>a==null?a:a[k],o);
const setp=(o,p,v)=>{const k=p.split('.'),l=k.pop();k.reduce((a,x)=>a[x],o)[l]=v};

const SAMPLE='Proyecto de ejemplo. Reemplazalo desde Editar › Trabajos con tus piezas: sumá links de YouTube o de Google Drive, o subí imágenes.';
const DEFAULTS={
  brand:{name:'Stiven Cruz',sub:'Diseño Multimedial',logo:'',showName:true},
  hero:{kicker:'Diseñador multimedial · gráfico y motion',title:'Stiven Cruz',
    roles:['key visuals','email marketing','assets para web y app','animación para redes','spots publicitarios','piezas para vía pública'],
    lead:'Más de 5 años creando campañas y comunicación digital para Mercado Libre, Mercado Pago y Mercado Crédito. Diseño, animo y adapto piezas para cada formato y canal.'},
  stats:[{v:'+5',l:'años de experiencia'},{v:'5',l:'países con campañas'},{v:'3',l:'marcas de Mercado'}],
  about:{text:'Diseñador Multimedia con más de 5 años de experiencia en campañas y comunicación digital. Participé en proyectos para Mercado Libre, Mercado Pago y Mercado Crédito, con trabajo para México, Colombia, Perú, Uruguay y Chile. Experiencia en mailing, redes sociales, paid media, assets para web y aplicaciones, animación y spots publicitarios, además de adaptaciones para vía pública. Orientado a resolver desafíos creativos, colaborar con equipos multidisciplinarios y optimizar piezas para distintos formatos y canales.',
    brands:['Mercado Libre','Mercado Pago','Mercado Crédito'],countries:['México','Colombia','Perú','Uruguay','Chile']},
  contact:{email:'Stivencruzdm@gmail.com',phone:'+54 9 11 2244-3811',whatsapp:'5491122443811',location:'Lanús Oeste, Buenos Aires, Argentina',linkedin:'',site:''},
  modules:[
    {id:'hero',label:'Inicio',on:true},{id:'about',label:'Perfil',on:true},{id:'works',label:'Trabajos',on:true},
    {id:'experience',label:'Experiencia',on:true},{id:'skills',label:'Competencias',on:true},{id:'education',label:'Formación',on:true},{id:'contact',label:'Contacto',on:true}],
  categories:['Key visuals','Email marketing','Web y app','Motion para redes','Spots','Vía pública','Banners HTML5'],
  clients:[{id:'c-ml',name:'Mercado Libre',on:true},{id:'c-mp',name:'Mercado Pago',on:true},{id:'c-mc',name:'Mercado Crédito',on:true}],
  works:[
    ['Adaptación de key visual','Key visuals','Campaña multi-formato'],['Pieza de email marketing','Email marketing','Mailing en distintas medidas'],
    ['Assets para app','Web y app','Plataformas web y aplicaciones'],['Animación para Instagram y TikTok','Motion para redes','Redes sociales'],
    ['Spot para pantallas digitales','Spots','Video animado'],['Gigantografía y espectacular','Vía pública','Impresión offset'],['Banner HTML5 responsive','Banners HTML5','Formatos publicitarios']
  ].map(([title,cat])=>({id:uid(),title,cat,clientId:'',year:'',tags:'',desc:SAMPLE,media:[],on:true,sample:true})),
  experience:[
    {company:'Super Media S.A.',role:'Diseñador Gráfico / Animador Motion',period:'Mayo 2022 – Febrero 2026',bullets:[
      'Creación y adaptación de key visuals (KVs) en múltiples formatos para campañas.','Diseño de piezas de mailing en diferentes medidas para campañas de email marketing.',
      'Desarrollo de assets para plataformas web y aplicaciones.','Colaboración con los equipos de cuentas y creatividad para resolver las necesidades del cliente.',
      'Animación de piezas para Instagram, Facebook, YouTube y TikTok.','Adaptación de piezas a distintos formatos, optimizando su peso y calidad.',
      'Producción de videos animados, tutoriales y spots publicitarios para pantallas digitales.','Diseño de piezas para impresión offset, incluyendo gigantografías, stands y espectaculares.']},
    {company:'Insite Latin America',role:'Diseñador Multimedial',period:'Febrero 2020 – Febrero 2021',bullets:[
      'Animación de piezas gráficas en distintos formatos para redes sociales.','Creación de videos siguiendo el BrandBook y los lineamientos de Mercado Pago, Mercado Libre y Mercado Crédito Argentina.',
      'Desarrollo de banners adaptativos y responsive en HTML5 para redes sociales.','Adaptación y animación de piezas gráficas para formatos publicitarios (Ads).']}],
  skills:[
    {title:'Diseño y comunicación digital',items:'Mailing, Email marketing, Redes sociales, Paid media, Key visuals, Banners, Assets web y app, Piezas publicitarias, Vía pública'},
    {title:'Video y motion',items:'Animación gráfica, Videos, Tutoriales, Spots publicitarios, Adaptación a múltiples formatos'},
    {title:'Herramientas y plataformas',items:'Adobe Illustrator, Adobe Photoshop, Adobe After Effects, Suite Adobe, WordPress, Tienda Nube, Mercado Libre'},
    {title:'Conocimientos técnicos',items:'HTML5, CSS3, Optimización de peso y calidad, Plataformas de creación de contenido con IA'}],
  education:{school:'Da Vinci – Primera Escuela de Arte Multimedial',career:'Diseño Multimedial',period:'Enero 2014 – Diciembre 2017',
    recognition:'Reconocimiento académico: certificado por desempeño destacado como estudiante de la carrera de Diseño Multimedial.'},
  theme:{red:'#ff3d54',cyan:'#27d7f2'},
  ui:{hideEdit:false,noAnim:false}
};

let S=load(); let query='';const selC=new Set(),selK=new Set();
function load(){try{const r=localStorage.getItem(KEY);if(r){return Object.assign(clone(DEFAULTS),migrate(JSON.parse(r)))}}catch(e){}return clone(DEFAULTS)}
function migrate(o){
  if(!Array.isArray(o.clients)){const cl=clone(DEFAULTS.clients);
    (o.works||[]).forEach(w=>{if(w.clientId===undefined){const n=String(w.client||'').trim();let c=null;
      if(n&&!w.sample){c=cl.find(x=>x.name.toLowerCase()===n.toLowerCase());if(!c){c={id:uid(),name:n,on:true};cl.push(c)}}
      w.clientId=c?c.id:'';delete w.client}});o.clients=cl}
  (o.works||[]).forEach(w=>{if(w.clientId===undefined)w.clientId=''});return o}
let saveT,renderT;
/* historial y versiones */
let hist=[JSON.stringify(S)],hi=0,firstEdit=true;
function pushHist(){const j=JSON.stringify(S);if(j===hist[hi])return;
  if(firstEdit){firstEdit=false;addVersion('Antes de editar (automática)',hist[hi],true)}
  hist=hist.slice(0,hi+1);hist.push(j);hi=hist.length-1;
  let tot=hist.reduce((a,x)=>a+x.length,0);while(hist.length>2&&(hist.length>80||tot>30e6)){tot-=hist.shift().length;hi--}
  updUR()}
function updUR(){const u=$('#undoB'),r=$('#redoB');if(u)u.disabled=hi<=0;if(r)r.disabled=hi>=hist.length-1}
function applyHist(d){const n=hi+d;if(n<0||n>=hist.length)return;hi=n;S=Object.assign(clone(DEFAULTS),migrate(JSON.parse(hist[hi])));try{localStorage.setItem(KEY,hist[hi])}catch(e){}updUR();drawDr();renderAll();toast(d<0?'Cambio deshecho':'Cambio rehecho')}
const IDB={db:null,open(){return new Promise((res,rej)=>{if(this.db)return res(this.db);try{const r=indexedDB.open('stiven-cruz-portfolio',1);r.onupgradeneeded=()=>r.result.createObjectStore('v',{keyPath:'id'});r.onsuccess=()=>{this.db=r.result;res(this.db)};r.onerror=()=>rej(r.error)}catch(e){rej(e)}})},
  async run(mode,fn){const db=await this.open();return new Promise((res,rej)=>{const q=fn(db.transaction('v',mode).objectStore('v'));q.onsuccess=()=>res(q.result);q.onerror=()=>rej(q.error)})},
  all(){return this.run('readonly',s=>s.getAll())},put(o){return this.run('readwrite',s=>s.put(o))},del(id){return this.run('readwrite',s=>s.delete(id))}};
let VERS;
async function loadVers(){try{VERS=(await IDB.all()).sort((x,y)=>y.t-x.t)}catch(e){VERS=null}if(typeof tab!=='undefined'&&tab==='datos'&&!dr.hidden)drawDr()}
async function addVersion(label,json,auto){try{await IDB.put({id:uid(),t:Date.now(),label,auto:!!auto,json});
  if(auto){const a=(await IDB.all()).filter(v=>v.auto).sort((x,y)=>y.t-x.t);for(const v of a.slice(8))await IDB.del(v.id)}
  await loadVers();return true}catch(e){return false}}
async function restoreVer(v,lookOnly){await addVersion('Antes de restaurar (automática)',JSON.stringify(S),true);const o=migrate(JSON.parse(v.json));
  if(lookOnly){['brand','hero','stats','theme','modules','ui'].forEach(k=>{if(o[k]!==undefined)S[k]=o[k]})}else S=Object.assign(clone(DEFAULTS),o);
  save();drawDr();renderAll();toast('Versión restaurada. Podés deshacerla con ↶')}
function save(){pushHist();try{localStorage.setItem(KEY,JSON.stringify(S));$('#saved').textContent='Guardado'}catch(e){$('#saved').textContent='';toast('No se pudo guardar: el navegador no tiene espacio. Probá con links en vez de imágenes subidas.')}}
function touch(){$('#saved').textContent='Guardando…';clearTimeout(saveT);saveT=setTimeout(save,300);clearTimeout(renderT);renderT=setTimeout(renderAll,250)}
