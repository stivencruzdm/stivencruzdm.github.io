  const blocks=[];list.forEach((w,i)=>{const k=keyOf(w),b=blocks[blocks.length-1];if(b&&b.k===k)b.c.push(cardArr[i]);else blocks.push({k,c:[cardArr[i]]})});
  const cards=blocks.map(b=>`<div class="grid${b.c.length>=CENTER_MIN?' mid':''}">${b.c.join('')}</div>`).join('');
  return `${secHead(m,'Trabajos')}<div class="filters rv">${chips}</div>
   ${list.length?`<div class="secs">${cards}</div>`:`<div class="empty">No encontré trabajos${q?` para “${esc(query)}”`:' con esos filtros'}.</div>`}`;
