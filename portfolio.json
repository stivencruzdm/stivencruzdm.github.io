  const stats=S.stats.map(s=>{const x=String(s.v).match(/^(\D*)(\d+)(.*)$/);
    return `<div><dt ${x?`data-count="${x[2]}" data-pre="${esc(x[1])}" data-suf="${esc(x[3])}"`:''}>${esc(s.v)}</dt><dd>${esc(s.l)}</dd></div>`}).join('');
