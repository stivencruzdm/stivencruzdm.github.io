    <div class="cta"><a class="btn" href="#works" data-go="works">Ver trabajos</a><a class="btn ghost" href="#contact" data-go="contact">Contacto</a></div>
    <dl class="stats">${stats}</dl></div>
    <div class="hero-art"><div class="honey">${cells}</div></div></div>
    <div class="marquee" aria-hidden="true"><div class="track">${mq}${mq}${mq}${mq}</div></div>`;
},
about(m){
  return `${secHead(m,'Diseño pensado para cada canal')}<div class="about"><p class="big rv">${esc(S.about.text)}</p>
   <div><div class="box rv" style="--d:1"><h4>Marcas</h4><ul class="chips">${lines(S.about.brands).map(b=>`<li>${esc(b)}</li>`).join('')}</ul></div>
   <div class="box rv" style="--d:2"><h4>Campañas para</h4><ul class="chips">${lines(S.about.countries).map(b=>`<li>${esc(b)}</li>`).join('')}</ul></div></div></div>`;
},
works(m){
  const all=wasUser();const clientsAll=S.clients.filter(c=>c.on&&all.some(w=>w.clientId===c.id)).map(c=>c.id);[...selC].forEach(c=>{if(!clientsAll.includes(c))selC.delete(c)});
  const pool=all.filter(w=>!selC.size||selC.has(w.clientId));const cats=[...new Set([...S.categories.filter(c=>pool.some(w=>w.cat===c)),...pool.map(w=>w.cat)])];[...selK].forEach(c=>{if(!cats.includes(c))selK.delete(c)});
  const q=query.trim().toLowerCase();
  const list=all.filter(w=>(!selC.size||selC.has(w.clientId))&&(!selK.size||selK.has(w.cat))&&(!q||[w.title,w.cat,cname(w.clientId),w.year,w.tags,w.desc,...w.media.filter(x=>x.on!==false).map(x=>(x.tags||'')+' '+(x.desc||''))].join(' ').toLowerCase().includes(q))).sort((x,y)=>{const o=id=>{const k=S.clients.findIndex(c=>c.id===id);return k<0?1e9:k};return o(x.clientId)-o(y.clientId)});
  const chip=(t,v,on,l)=>`<button type="button" class="chip ${on?'on':''}" data-${t}="${esc(v)}" aria-pressed="${on}">${esc(l??v)}</button>`;
  const row=(label,clr,set,vals,t,lab)=>`<div class="frow" role="group" aria-label="${label}"><span class="fl">${label}</span><button type="button" class="chip ${set.size?'':'on'}" data-clear="${clr}">Todos</button>${vals.map(v=>chip(t,v,set.has(v),lab?lab(v):v)).join('')}</div>`;
  const chips=(clientsAll.length?row('Cliente','c',selC,clientsAll,'client',cname):'')+row('Categoría','k',selK,cats,'kat');
